            text-align: center;
            margin-bottom: 30px;
        }
        .features div, .how-it-works div {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
        }
        .features div > div, .how-it-works div > div {
            flex: 1 1 200px;
            margin: 10px;
            padding: 20px;
            background-color: #f4f4f9;
            border-radius: 10px;
            text-align: center;
            transition: transform 0.3s;
        }
        .features div > div:hover, .how-it-works div > div:hover {
            transform: scale(1.05);
        }
        .testimonials blockquote {
            font-style: italic;
            border-left: 5px solid #4a90e2;
            padding-left: 10px;
            margin: 20px 0;
        }
        .pricing table {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            border-collapse: collapse;
        }
        .pricing th, .pricing td {
            padding: 15px;
            border: 1px solid #ddd;
            text-align: center;
        }
        .pricing th {
            background-color: #4a90e2;
            color: #fff;
        }
        .pricing td {
            background-color: #f4f4f9;
        }
        footer {
            background-color: #333;
            color: #fff;
            text-align: center;
            padding: 20px;
        }
        footer a {
            color: #e94e77;
            margin: 0 10px;
            text-decoration: none;
        }
        footer a:hover {
