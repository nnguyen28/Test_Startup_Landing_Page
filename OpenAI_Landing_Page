            margin-top: 10px;
        }
        .hero {
            padding: 50px 20px;
            text-align: center;
            background-color: #fff;
        }
        .hero h2 {
            font-size: 2em;
            margin-bottom: 20px;
        }
        .hero button {
            background-color: #e94e77;
            color: #fff;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        .hero button:hover {
            background-color: #d43f67;
        }
        .features, .how-it-works, .testimonials, .pricing {
            padding: 50px 20px;
            background-color: #fff;
            margin: 20px 0;
        }
